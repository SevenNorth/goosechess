{
  "name": "@goose-chess/content-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./map-migration": {
      "types": "./src/map-migration.ts",
      "development": "./src/map-migration.ts",
      "default": "./dist/map-migration.js"
    },
    "./runtime-content": {
      "types": "./src/runtime-content.ts",
      "development": "./src/runtime-content.ts",
      "default": "./dist/runtime-content.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@goose-chess/game-content": "0.1.0",
    "@goose-chess/game-core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
