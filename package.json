{
  "name": "goose-chess",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0 <25",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @goose-chess/web",
    "build": "npm run build --workspace @goose-chess/web",
    "preview": "npm run preview --workspace @goose-chess/web",
    "test": "npm run test --workspace @goose-chess/web",
    "typecheck": "npm run typecheck --workspace @goose-chess/web",
    "lint": "npm run lint --workspace @goose-chess/web"
  }
}
