{
  "name": "goose-chess",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0 <25",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @goose-chess/web",
    "dev:e2e": "vite apps/web --host 127.0.0.1 --port 4173",
    "dev:e2e:server": "npm run build --workspace @goose-chess/game-server && node apps/game-server/dist/index.js",
    "build": "npm run build --workspace @goose-chess/game-core && npm run build --workspace @goose-chess/game-protocol && npm run build --workspace @goose-chess/game-content && npm run build --workspace @goose-chess/game-ai && npm run build --workspace @goose-chess/game-server && npm run build --workspace @goose-chess/content-tools && npm run build --workspace @goose-chess/content-server && npm run build --workspace @goose-chess/admin && npm run build --workspace @goose-chess/web",
    "build:rules": "npm run build --workspace @goose-chess/game-core && npm run build --workspace @goose-chess/game-protocol && npm run build --workspace @goose-chess/game-content && npm run build --workspace @goose-chess/game-ai",
    "dev:server": "npm run dev --workspace @goose-chess/game-server",
    "dev:content-server": "npm run dev --workspace @goose-chess/content-server",
    "preview": "npm run preview --workspace @goose-chess/web",
    "dev:admin": "npm run dev --workspace @goose-chess/admin",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && npm run check:boundaries",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "simulate": "npm run build:rules && node scripts/simulate.mjs",
    "validate:content": "npm run build:rules && node scripts/validate-content.mjs",
    "check:versions": "node scripts/check-version-upgrades.mjs",
    "check:release": "node scripts/check-release-assets.mjs",
    "e2e": "playwright test --tsconfig apps/web/tsconfig.app.json",
    "e2e:ci": "playwright test --tsconfig apps/web/tsconfig.app.json stage7-release.spec.ts online-release.spec.ts",
    "e2e:stability": "node scripts/run-stability.mjs",
    "e2e:stability:smoke": "node scripts/run-stability.mjs --minutes=0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/pngjs": "6.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}