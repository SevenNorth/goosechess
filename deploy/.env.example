# Public HTTPS origins handled by the host Nginx. Do not add a trailing slash.
PLAYER_PUBLIC_URL=https://play.example.com
ADMIN_PUBLIC_URL=https://admin.example.com

# Bind only to loopback; the host Nginx is the public entry point.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8082
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=8081

# Generate independent random values. Keep this file outside Git.
CONTENT_RUNTIME_TOKEN=replace-with-at-least-32-random-characters
CONTENT_BOOTSTRAP_USERNAME=admin
CONTENT_BOOTSTRAP_PASSWORD=replace-with-a-strong-random-password
CONTENT_BOOTSTRAP_DISPLAY_NAME=Administrator
CONTENT_COOKIE_SECURE=true
